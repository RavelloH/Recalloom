{
  "name": "recalloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned cross-session context storage for AI agents",
  "scripts": {
    "dev": "pnpm build:web && wrangler dev",
    "deploy": "pnpm build:web && node scripts/predeploy-check.mjs && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc && wrangler deploy --config wrangler.deploy.jsonc",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:web": "node scripts/web-api-e2e.mjs",
    "db:local": "wrangler d1 migrations apply recalloom --local",
    "db:remote": "wrangler d1 migrations apply recalloom --remote",
    "build:web": "node scripts/stage-cap-wasm.mjs && vite build",
    "dev:web": "node scripts/stage-cap-wasm.mjs && vite --host 127.0.0.1",
    "test:ui": "node scripts/web-ui-e2e.mjs",
    "test:editor": "node scripts/tiptap-roundtrip-e2e.mjs && node scripts/tiptap-interactions-e2e.mjs",
    "test:drafts": "node scripts/web-draft-ui-e2e.mjs",
    "test:panels": "node scripts/web-panels-ui-e2e.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.4",
    "@astryxdesign/theme-neutral": "^0.7.4",
    "@cap.js/wasm": "^0.0.8",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@modelcontextprotocol/server": "^2.4.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@uiw/react-codemirror": "^4.25.12",
    "cap-widget": "^0.1.58",
    "capjs-core": "0.1.3",
    "codemirror": "^6.0.2",
    "diff": "^8.0.2",
    "hono": "4.11.5",
    "katex": "^0.16.47",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "text-version": "^2.1.0",
    "unified": "^11.0.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  }
}
