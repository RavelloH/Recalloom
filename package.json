{
  "name": "recalloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned cross-session context storage for AI agents",
  "scripts": {
    "dev": "pnpm build:web && node scripts/generate-help.mjs --watch -- node ./node_modules/wrangler/bin/wrangler.js dev",
    "deploy": "pnpm help:check && pnpm build:web && node scripts/predeploy-check.mjs && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc && wrangler deploy --config wrangler.deploy.jsonc",
    "check": "pnpm styles:check && pnpm help:check && pnpm icons:check && pnpm syntax:check && tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "syntax:check": "node scripts/audit-editor-syntax.mjs",
    "styles:check": "node scripts/check-style-architecture.mjs",
    "icons:check": "node scripts/check-icons.mjs",
    "test:icons:ui": "node scripts/icon-system-e2e.mjs",
    "test:chat:ui": "node scripts/rmd-chat-ui-e2e.mjs",
    "test:inline:ui": "node scripts/editor-inline-menu-e2e.mjs",
    "test:direct-title:ui": "node scripts/editor-direct-title-e2e.mjs && node scripts/editor-code-direct-title-e2e.mjs",
    "test:attrs-drawer:ui": "node scripts/editor-rmd-attrs-drawer-e2e.mjs",
    "test:rich-fields:ui": "node scripts/editor-rich-container-fields-e2e.mjs && node scripts/editor-rich-leaf-fields-e2e.mjs && node scripts/editor-container-id-e2e.mjs",
    "test:block:ui": "node scripts/editor-block-menu-e2e.mjs && node scripts/editor-child-block-e2e.mjs",
    "test:block-handle:ui": "node scripts/editor-block-handle-e2e.mjs && node scripts/editor-block-drag-e2e.mjs && node scripts/editor-nested-block-handle-e2e.mjs && node scripts/editor-nested-block-drag-e2e.mjs && node scripts/editor-container-id-e2e.mjs",
    "test:context:ui": "node scripts/editor-context-menu-e2e.mjs",
    "test:sketch:ui": "node scripts/rmd-sketch-e2e.mjs && node scripts/rmd-sketch-layout-e2e.mjs",
    "test": "pnpm help:check && tsx --test test/*.test.ts test/*.test.tsx",
    "test:migrations": "node scripts/verify-migrations.mjs",
    "test:web": "node scripts/web-api-e2e.mjs",
    "test:oauth": "node scripts/oauth-flow-e2e.mjs",
    "db:local": "wrangler d1 migrations apply recalloom --local",
    "db:remote": "wrangler d1 migrations apply recalloom --remote",
    "build:web": "node scripts/stage-cap-wasm.mjs && vite build",
    "dev:web": "node scripts/stage-cap-wasm.mjs && vite --host 127.0.0.1",
    "test:ui": "node scripts/web-ui-e2e.mjs",
    "test:editor": "pnpm build:web && node scripts/run-editor-e2e.mjs",
    "test:editor:quick": "node scripts/run-editor-e2e.mjs",
    "test:rmd:performance": "tsx scripts/rmd-performance.ts",
    "test:typography": "node scripts/markdown-typography-e2e.mjs",
    "test:confirm": "node scripts/alert-dialog-e2e.mjs",
    "test:drafts": "node scripts/web-draft-ui-e2e.mjs",
    "test:panels": "node scripts/web-panels-ui-e2e.mjs",
    "test:workspace": "node scripts/notion-workspace-e2e.mjs",
    "test:archive": "node scripts/archive-management-e2e.mjs",
    "test:graph": "node scripts/knowledge-graph-e2e.mjs",
    "test:graph-theme": "node scripts/graph-theme-e2e.mjs",
    "test:wiki": "node scripts/wiki-e2e.mjs",
    "test:help:e2e": "node scripts/help-examples-e2e.mjs",
    "test:help:ui": "node scripts/rmd-help-web-e2e.mjs",
    "help:generate": "node scripts/generate-help.mjs",
    "help:watch": "node scripts/generate-help.mjs --watch",
    "help:check": "node scripts/generate-help.mjs --check"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.4",
    "@astryxdesign/theme-neutral": "^0.7.4",
    "@cap.js/wasm": "^0.0.8",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/server": "^2.4.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@uiw/react-codemirror": "^4.25.12",
    "cap-widget": "^0.1.58",
    "capjs-core": "0.1.3",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.4",
    "diff": "^8.0.2",
    "dompurify": "^3.4.17",
    "hono": "4.11.5",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "motion": "^12.43.0",
    "overlayscrollbars": "^2.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.6.0",
    "text-version": "2.2.0",
    "tiptap-extension-code-block-shiki": "^1.2.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  }
}
